{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syncanime",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/anime/*", "/api/*", "/health"]
  },
  "observability": { "enabled": false }
}
